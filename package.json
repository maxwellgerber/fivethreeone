{
  "name": "fivethreeone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A 5/3/1 Forever training log PWA. No accounts, no subscription, your data stays on your phone.",
  "scripts": {
    "build": "node build.mjs",
    "build:seeded": "node build.mjs --seed --single",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p worker",
    "serve": "npx --yes serve dist",
    "import-notes": "node --experimental-strip-types tools/import-notes.ts",
    "dev": "npm run build && npx wrangler dev",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.27.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
